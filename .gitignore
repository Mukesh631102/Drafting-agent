# ==========================================
# EduFinance Drafting Agent - .gitignore
# ==========================================

# 1. Environment & Sensitive Secrets
.env
.env.*
!.env.example

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 4. Database & Persistence
instance/
*.db
*.sqlite
*.sqlite3

# 5. Output Drafts & Exported PDFs
outputs/
*.pdf
scratch/

# 6. Streamlit & Web Framework Caches
.streamlit/secrets.toml
.streamlit/*.pyc

# 7. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~