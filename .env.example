# ==========================================
# EduFinance Drafting Agent - Environment Configuration
# ==========================================

# Groq API Key (Required for high-speed LLM reasoning)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model ID (Default: openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL_ID=openai/gpt-oss-120b

# Google Gemini API Key (Optional / For LangGraph fallback & Multi-Agent Flow)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment Settings
FLASK_APP=app.py
FLASK_DEBUG=0
